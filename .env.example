# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
DEFAULT_MODEL=openai/gpt-oss-120b

# TiDB Serverless / MySQL Database Configuration
MYSQL_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your_tidb_user.root
MYSQL_PASSWORD=your_tidb_password
MYSQL_DATABASE=codementorai
MYSQL_USE_SSL=true

# Security
JWT_SECRET_KEY=generate_a_random_32_char_secret_key_here
